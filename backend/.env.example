APP_NAME=TravelGuard AI
APP_ENV=development
APP_DEBUG=true
API_V1_PREFIX=/api/v1
LOG_LEVEL=INFO
CORS_ORIGINS=*

# Google Gemini AI
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-3.5-flash-lite

# Groq AI
GROQ_API_KEY=your-groq-api-key
GROQ_MODEL=llama-3.3-70b-versatile

# Supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_ANON_KEY=your-publishable-key
SUPABASE_DB_PASSWORD=your-db-password

# OpenWeather
OPENWEATHER_API_KEY=your-openweather-api-key
OPENWEATHER_UNITS=metric

# Copernicus Data Space
COPERNICUS_DATA_SPACE_URL=https://dataspace.copernicus.eu/
COPERNICUS_USERNAME=your-username
COPERNICUS_PASSWORD=your-password

# Geocoding & Routing (OSM)
NOMINATIM_BASE_URL=https://nominatim.openstreetmap.org
NOMINATIM_USER_AGENT=TravelGuardAI/1.0 (you@example.com)
OSRM_BASE_URL=https://router.project-osrm.org
OVERPASS_API_URL=https://overpass-api.de/api/interpreter
PHOTON_API_URL=https://photon.komoot.io/api/

# Big Data Cluster (Docker)
HDFS_WEBHDFS=http://localhost:9870
KAFKA_BOOTSTRAP=localhost:9094
SPARK_UI=http://localhost:8080

